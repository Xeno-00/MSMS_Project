         R 180 88
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\R.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:35:37</TimeStamp>
</Description>
</Information>';
          type R
           ports
            power in p;
          end;
          icon bg ellipse bottom
           figures
            text 'R' 180 88 color 0 18 bold;
          end;
          implementation eq
variables
	real flow;


parameters
	real B       = 6.1e-4; //viscous coefficient (B = 6.4e-4 without payload)
	real B_plus  = 0.008;  //coulumb friction
	real B_minus = -0.007; //coulumb friction
	
equations
	flow = p.f;
	if flow > 0 then
		p.e = B*p.f + B_plus;
	else
		p.e = B*p.f + B_minus;
	end;
implementation_end;
         R1 592 488
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
