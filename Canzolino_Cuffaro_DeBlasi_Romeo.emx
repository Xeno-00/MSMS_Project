      L2 824 240
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Graphical'
        ports
         power in A [6,1];
         power out B2 [6,1];
         signal in H1_0 [4,4];
         signal in q2;
         signal out H2_0 [4,4];
       end;
       icon bg shadow 8421504
        figures
         rectangle 768 200 880 280 color 0 fill 12623485;
         text 'name' 824 240 color 0 16;
       end;
       implementation bg
        submodels
         Euler_EQ1 659 202
          description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
          type 'Submodel-Equation'
           ports
            signal out P_OG [3,1]; "position of center of gravity"
            signal out R_OG [3,3]; "orientation"
            power in twist [6,1];
            power in FG [4,1];
           parameters
            real m = 8.393 {kg}; "mass"
            real J[3,3] = [0.0149, 0.0, 0.0; 0.0, 0.3564, 0.0; 0.0, 0.0, 0.3553]; "inertia tensor"
            real R_OG_0[3,3] = [1, 0, 0; 0, 0, -1; 0, 1, 0]; "initial value of the rotational matrix"
            real P_OG_0[3,1] = [-0.21249; -0.113336; 0.089159];
          end;
          implementation eq

variables
	real omega[3,1], v[3,1];
	//dynamic equations
	real p[3,1],h[3,1];
equations
   v = twist.f[1:3,1];
   omega = twist.f[4:6,1];

	// Euler equations
	p = int(twist.e[1:3,1]+FG.e[1:3,1]-skew(omega)*p);
	h = int(twist.e[4:6,1]-skew(omega)*h);
	
	R_OG = int(R_OG*skew(omega),R_OG_0);
	P_OG = int(R_OG*v,P_OG_0);
	twist.f[1:3,1] = p/m;
	twist.f[4:6] = inverse(J)*h;
	FG.f[1:3,1]  = twist.f[1:3,1];
  	FG.f[4,1]   = 1;


 implementation_end;
         MSe1 656 80
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MSe.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:12:33</TimeStamp>
</Description>
</Information>';
          type MSe
           ports
            power out FG [4,1];
            signal in q2;
            signal in H1_0 [4,4];
            signal out H2_0 [4,4];
           restrictions
            causality fixed out FG;
          end;
          icon bg ellipse bottom
           figures
            text 'MSe' 656 80 color 0 18 bold;
          end;
          implementation eq
variables
	real flow[4,1];
	real theta2;
	real H2_1[4,4];
	
parameters
	real d2 = 0.0, a2 = -0.425, alpha2 = 0, q2_0 = 0.0;
   real m2 = 8.393, g=9.81;
	real fg2[4,1] = [0;0;-m2*g;0];
	
equations
	theta2 = q2 + q2_0;
	
	H2_1 = [cos(theta2),-sin(theta2)*cos(alpha2),sin(theta2)*sin(alpha2),a2*cos(theta2); 
	     sin(theta2),cos(theta2)*cos(alpha2),-cos(theta2)*sin(alpha2),	a2*sin(theta2); 
	     0,         sin(alpha2),            cos(alpha2),            		d2;
	     0,         0,                     0,                    1];
	
	H2_0 = H2_1 * H1_0;
	
	FG.e = transpose(H2_0) * fg2;
	flow = FG.f;


implementation_end;
         MTFA 313 152
          description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\3D\MTF-3.emx</LibraryPath><TimeStamp>2007-9-25 12:11:21</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
