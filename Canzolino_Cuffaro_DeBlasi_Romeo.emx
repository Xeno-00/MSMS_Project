         R 208 119
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\R.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:35:37</TimeStamp>
</Description>
</Information>';
          type R
           ports
            power in p;
          end;
          icon bg ellipse bottom
           figures
            text 'R' 208 119 color 0 18 bold;
          end;
          implementation eq
variables
	real flow;


parameters
	real B       = 6.1e-4; //viscous coefficient (B = 6.4e-4 without payload)
	real B_plus  = 0.008;  //coulumb friction
	real B_minus = -0.007; //coulumb friction
	
equations
	flow = p.f;
	if flow > 0 then
		p.e = B*p.f + B_plus;
	else
		p.e = B*p.f + B_minus;
	end;
implementation_end;
         R1 600 463
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\R.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:35:37</TimeStamp>
</Description>
</Information>';
          type R
           ports
            power in p;
          end;
          icon bg ellipse bottom
           figures
            text 'R' 600 463 color 0 18 bold;
          end;
          implementation eq
parameters
	real r = 0.1;
equations
	p.e = r * p.f;
implementation_end;
         Spring 377 467
          description '<Information><Description><Version>4.2</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\C.emx</LibraryPath><TimeStamp>2011-11-29 15:58:35</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
          type C
           ports
            power in p;
            signal out state;
           restrictions
            causality preferred out p;
          end;
          icon bg ellipse bottom
           figures
            text 'C' 377 467 color 0 18 bold;
          end;
          implementation eq
variables
	//real c;
   real phi1;
   real phi2;

parameters
	real k1 = 16e3;
	real k2 = 25e3;
	real k3 = 29e3;
	real T1 = 7;
	real T2 = 25;

equations
	state = int(p.f); // state phi
	
   phi1 = T1/k1;
   phi2 = T1/k1+ (T2-T1)/k2; 

	if state <= phi1 or state >= -phi1 then   // first region
		p.e = state * k1;
	 
	elsif state > phi2 or state < -phi2 then // third region
		p.e = (state -sign(state)*phi2)*k3 +sign(state)*T2;
		
	else                                       // second region
		p.e = (state -sign(state)*phi1)*k2 +sign(state)*T1;
	end;implementation_end;
         TF 232 368
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
