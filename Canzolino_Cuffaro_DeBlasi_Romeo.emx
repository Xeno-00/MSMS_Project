       implementation bg
        submodels
         Euler_EQ1 659 202
          description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
          type 'Submodel-Equation'
           ports
            signal out P_OG [3,1]; "position of center of gravity"
            signal out R_OG [3,3]; "orientation"
            power in twist [6,1];
            power in FG [4,1];
           parameters
            real m = 3.7 {kg}; "mass"
            real J[3,3] = [0.0067, 0.0, 0.0; 0.0, 0.0064, 0.0; 0.0, 0.0, 0.0067]; "inertia tensor"
            real R_OG_0[3,3] = [1, 0, 0; 0, 0, -1; 0, 1, 0]; "initial value of the rotational matrix"
            real P_OG_0[3,1] = [0; -0.0019301; 0.06354];
          end;
          implementation eq
variables
	real omega[3,1], v[3,1];
	//dynamic equations
	real p[3,1],h[3,1];
	
equations
   v = twist.f[1:3,1];
   omega = twist.f[4:6,1];
  
	//Euler equations
	p = int(twist.e[1:3,1]+FG.e[1:3,1]-skew(omega)*p);
	h = int(twist.e[4:6,1]-skew(omega)*h);
	
	R_OG = int(R_OG*skew(omega),R_OG_0);
	P_OG = int(R_OG*v,P_OG_0);
	twist.f[1:3,1] = p/m;
	twist.f[4:6] = inverse(J)*h;
	FG.f[1:3,1]  = twist.f[1:3,1];
   FG.f[4,1]   = 1;

 implementation_end;
         MSe1 656 88
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MSe.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:12:33</TimeStamp>
</Description>
</Information>';
          type MSe
           ports
            power out FG [4,1];
            signal in q1;
            signal out H1_0 [4,4];
           restrictions
            causality fixed out FG;
          end;
          icon bg ellipse bottom
           figures
            text 'MSe' 656 88 color 0 18 bold;
          end;
          implementation eq
variables
	real flow[4,1];
	real theta1;

parameters
		real d1 = 0.089159, a1 = 0, alpha1 = 1.57079, q1_0 = 0.0;
		real m1 = 3.7, g=9.81;
		real fg1[4,1] = [0;0;-m1*g;0];
		
equations
	theta1 = q1 + q1_0;
		
	H1_0 = [cos(theta1),-sin(theta1)*cos(alpha1),sin(theta1)*sin(alpha1),a1*cos(theta1); 
	     		sin(theta1),cos(theta1)*cos(alpha1),-cos(theta1)*sin(alpha1),	a1*sin(theta1); 
	     		0,         sin(alpha1),            cos(alpha1),            		d1;
	    		0,         0,                     0,                    1];
	
	FG.e = transpose(H1_0) * fg1;
	flow = FG.f;
implementation_end;
