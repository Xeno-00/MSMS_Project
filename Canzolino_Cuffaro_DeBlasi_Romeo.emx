   Wrist2 274 132
    description '<Information><Description><Version>4.0</Version><LibraryPath>System\Submodel.emx</LibraryPath><TimeStamp>2007-10-31 11:32:54</TimeStamp><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
    type Submodel
     ports
      power in B4 [6,1];
      signal in H4_0 [4,4];
      signal out H5_0 [4,4];
      power out B5 [6,1];
    end;
    icon bg
     figures
      rectangle 252 96 296 168 color 0 fill 2124031;
      text 'name' 274 132 color 0 16;
    end;
    implementation bg
     submodels
      C5 168 264
       description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Signal\Control\PID Control\Continuous\PID.emx</LibraryPath><TimeStamp>2008-1-17 10:49:30</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type PID
        ports
         signal in SP;
         signal in MV;
         signal out output;
       end;
       icon bg bottom
        figures
         rectangle 152 248 184 280 color 0 fill 15132390;
         text 'PID
' 168 263.5 color 16711680 14 bold;
       end;
       implementation eq
parameters
	real kp = -2.0 {};		// Proportional gain 
	
	real tauI = 0.5 {s};		// Integral time constant: tauI > 0 (speed at which the integral action accumulates in response to the error)
	real tauA = 0.1 {s};		// Anti-windup/tracking time constant: tauA > 0 (prevents the integrator from accumulating excessive error)

	real tauD = 0.1 {s};		// Derivative time constant: tauD > 0
	real N = 20 {};			// Derivative gain limitation (limits the amplification of noise that the derivative can generate)
	
	real min_val = -7 {};	// Minimum output
	real max_val = 7 {};		// Maximum output
	
variables
	real error;
	real hidden uP;
	real hidden uI;
	real hidden uD, uDstate;
	real hidden desired_output;
	
equations
	error = SP - MV;
	
	uP = kp * error ;
	
	uI = int ( kp * error / tauI  -  ( desired_output - output ) / tauA );
	
	uDstate = int ( uD * N / tauD );
	uD = kp * error * N - uDstate;	   
	
	desired_output = uP + uI + uD;
		
	output = limit(desired_output, min_val, max_val);

      
implementation_end;
