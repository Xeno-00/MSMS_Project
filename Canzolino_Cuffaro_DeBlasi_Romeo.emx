         I 632 296
          description '<Information><Description><Version>4.0</Version><LibraryPath>Signal\Block Diagram\Splitter.emx</LibraryPath><TimeStamp>2008-01-17 11:28:29</TimeStamp><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
          knot Splitter
           ports
            signal knot duplicatable out output [1];
            signal knot in input [1];
          end;
          icon bg ellipse bottom
           figures
            ellipse 628.8 292.8 635.2 299.2 color -1 fill 0;
            ellipse 627.7 291.7 636.3 300.3 color -1;
           terminals
            input 632 296 fixed;
          end;
          implementation eq
equations
    collect (output) = input;
implementation_end;
         Integrate 632 512
          description '<Information>
 <Description>
    <Version>4.3</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Signal\Block Diagram\Integrate.emx</LibraryPath>
  <TimeStamp>2013-3-8 14:47:42</TimeStamp>
</Description>
</Information>';
          type Integrate
           ports
            signal in input;
            signal out q;
          end;
          icon bg bottom
           figures
            rectangle 616 496 648 528 color 0 fill 15132390;
            text '∫' 632 512.3 color 16711680 'Lucida Sans' 21 italic;
          end;
          implementation eq
parameters
	real initial = 0;		// initial value
equations
	q = int (input, initial);
     implementation_end;
         LC 408 184
          description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
          type 'Submodel-Graphical'
           ports
            power in input [3,1];
            power out output [3,1];
          end;
          implementation bg
           submodels
            ConstraintForce1 352 24
             type 'ConstraintForce-Relative'
              ports
               power out p [3,1];
              restrictions
               causality fixed out p;
             end;
             icon ipm ellipse top
              figures
               line 368 24 384 24 color 0 end;
               text 'v = 0' 352 24 color 0 14;
               line 336 24 320 24 color 0 end;
             end;
             implementation eq
equations
	// Note: the constraint function is used here
	p.e = constraint(p.f);
	// you can read the equation as:
	// On every simulation step make p.F such that p.v remains zeroimplementation_end;
            plug input 104 152;
            plug output 632 152;
            ZeroJunction3 352 152
             description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\ZeroJunction.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:45:16</TimeStamp>
</Description>
</Information>';
             knot ZeroJunction
              ports
               power knot duplicatable none p [3,1];
               signal knot out effort [3,1];
              restrictions
               causality constraint one_in p;
             end;
             icon bg ellipse
              figures
               text '0' 352 152 color 0 18 bold;
             end;
             implementation eq
equations
	sum (direct (p.f)) = 0;
	equal (collect (p.e));
	effort = first (p.e);
implementation_end;
           end;
           connections
            ConstraintForce1\p => ZeroJunction3\p;
            ZeroJunction3\p <= input;
            ZeroJunction3\p => output;
           end;
          implementation_end;
         MTF 544 184
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MTF.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:15:31</TimeStamp>
</Description>
</Information>';
          type MTF
           ports
            power in p1 [3,1];
            power out p2 [3,1];
            signal in q;
           restrictions
            causality constraint not_equal p1 p2;
          end;
          icon bg ellipse bottom
           figures
            text 'MTF' 544 184 color 0 18 bold;
          end;
          implementation eq

variables
	real R_AB [3,3];
equations
  R_AB = [cos(q),-sin(q),0;
          sin(q),cos(q),0;
          0,0,1];
	p2.e = transpose(R_AB) * p1.e ;
	p1.f = R_AB * p2.f;
implementation_end;
         MTF1 544 344
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MTF.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:15:31</TimeStamp>
</Description>
</Information>';
          type MTF
           ports
            power in p1 [3,1];
            power out p2 [3,1];
            signal in q;
           restrictions
            causality constraint not_equal p1 p2;
          end;
          icon bg ellipse bottom
           figures
            text 'MTF' 544 344 color 0 18 bold;
          end;
          implementation eq

variables
	real R_AB [3,3];
equations
  R_AB = [cos(q),-sin(q),0;
          sin(q),cos(q),0;
          0,0,1];
	p2.e = transpose(R_AB) * p1.e ;
	p1.f = R_AB * p2.f;
implementation_end;
         plug q1 776 296;
         plug input 168 256;
         plug output 768 248;
