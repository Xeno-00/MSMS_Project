         RC 392 392
          description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
          type 'Submodel-Graphical'
           ports
            power in input [2,1];
            power out output [2,1];
          end;
          implementation bg
           submodels
            ConstraintForce1 456 288
             type 'ConstraintForce-Relative'
              ports
               power out p [2,1];
              restrictions
               causality fixed out p;
             end;
             icon ipm ellipse top
              figures
               line 472 288 488 288 color 0 end;
               text 'v = 0' 456 288 color 0 14;
               line 440 288 424 288 color 0 end;
             end;
             implementation eq
equations
	// Note: the constraint function is used here
	p.e = constraint(p.f);
	// you can read the equation as:
	// On every simulation step make p.F such that p.v remains zeroimplementation_end;
            plug input 232 384;
            plug output 760 384;
            ZeroJunction4 456 384
             description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\ZeroJunction.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:45:16</TimeStamp>
</Description>
</Information>';
             knot ZeroJunction
              ports
               power knot duplicatable none p [2,1];
               signal knot out effort [2,1];
              restrictions
               causality constraint one_in p;
             end;
             icon bg ellipse
              figures
               text '0' 456 384 color 0 18 bold;
             end;
             implementation eq
equations
	sum (direct (p.f)) = 0;
	equal (collect (p.e));
	effort = first (p.e);
implementation_end;
           end;
           connections
            ConstraintForce1\p => ZeroJunction4\p;
            ZeroJunction4\p <= input;
            ZeroJunction4\p => output;
           end;
          implementation_end;
         Splitter1 608 296
          description '<Description><Version>4.0</Version>
   <LibraryPath>Signal\Block Diagram\Splitter.emx</LibraryPath>
  <TimeStamp>2008-01-17 11:28:29</TimeStamp>
<IsMainModel>1</IsMainModel>
 <KeepParameterValues>False</KeepParameterValues>
</Description>';
          knot Splitter
           ports
            signal knot duplicatable out output [1];
            signal knot in input [1];
          end;
          icon bg ellipse bottom
           figures
            ellipse 604.8 292.8 611.2 299.2 color -1 fill 0;
            ellipse 603.7 291.7 612.3 300.3 color -1;
           terminals
            input 608 296 fixed;
          end;
          implementation eq
equations
    collect (output) = input;
implementation_end;
         ZeroJunction 360 424
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\ZeroJunction.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:45:16</TimeStamp>
</Description>
</Information>';
          knot ZeroJunction
           ports
            power knot duplicatable none p [1];
            signal knot out effort [1];
           restrictions
            causality constraint one_in p;
          end;
          icon bg ellipse
           figures
            text '0' 360 424 color 0 18 bold;
          end;
          implementation eq
equations
	sum (direct (p.f)) = 0;
	equal (collect (p.e));
	effort = first (p.e);
implementation_end;
        end;
        connections
         ActuatorT => FlowSensor1\p1;
         FlowSensor1\flow -> Integrate\input;
         FlowSensor1\p2 => ZeroJunction\p;
         input => PowerDemux2\input;
         Integrate\q -> Splitter1\input;
         LC\output => MTF\p1;
         MTF\p2 => PowerMux1\input1 688 184;
         MTF1\p2 => PowerMux1\input2 688 344;
         PowerDemux\output1 => RC\input;
         PowerDemux\output2 => ZeroJunction\p;
         PowerDemux2\output1 => LC\input 232 176;
         PowerDemux2\output2 => PowerDemux\input 232 416;
         PowerMux\output => MTF1\p1 544 416;
         PowerMux1\output => output;
         RC\output => PowerMux\input1;
         Splitter1\output -> MTF\q 544 296;
         Splitter1\output -> MTF1\q 544 296;
         Splitter1\output -> q4;
         ZeroJunction\p => PowerMux\input2;
        end;
       implementation_end;
      L4 760 236
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Graphical'
        ports
         power in A [6,1];
         power out B4 [6,1];
         signal in q4;
         signal in H3_0 [4,4];
         signal out H4_0 [4,4];
       end;
       icon bg shadow 8421504
        figures
         rectangle 704 192 816 280 color 0 fill 3329330;
         text 'name' 760 236 color 0 16;
       end;
       implementation bg
        submodels
         Euler_EQ1 659 202
          description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
          type 'Submodel-Equation'
           ports
            signal out P_OG [3,1]; "position of center of gravity"
            signal out R_OG [3,3]; "orientation"
            power in twist [6,1];
            power in FG [4,1];
           parameters
            real m = 1.1219 {kg}; "mass"
            real J[3,3] = [0.0012, 0.0, 0.0; 0.0, 0.0012, 0.0; 0.0, 0.0, 9.0e-4]; "inertia tensor"
            real R_OG_0[3,3] = [1, 0, 0; 0, -1, 0; 0, 0, -1]; "initial value of the rotational matrix"
            real P_OG_0[3,1] = [-0.81724; -0.107352; 0.07281];
          end;
          implementation eq

variables
	// need to take out both velocities
	// angular and linear
	real omega[3,1], v[3,1];
	// write dynamic equations
	real p[3,1],h[3,1];
equations
  v = twist.f[1:3,1];
  omega = twist.f[4:6,1];

	// Euler equations
	p = int(twist.e[1:3,1]+FG.e[1:3,1]-skew(omega)*p);
	h = int(twist.e[4:6,1]-skew(omega)*h);
	
	R_OG = int(R_OG*skew(omega),R_OG_0);
	P_OG = int(R_OG*v,P_OG_0);
	twist.f[1:3,1] = p/m;
	twist.f[4:6] = inverse(J)*h;
	FG.f[1:3,1]  = twist.f[1:3,1];
  FG.f[4,1]   = 1;


 implementation_end;
         MSe1 656 88
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MSe.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:12:33</TimeStamp>
</Description>
</Information>';
          type MSe
           ports
            power out FG [4,1];
            signal in q4;
            signal in H3_0 [4,4];
            signal out H4_0 [4,4];
           restrictions
            causality fixed out FG;
          end;
          icon bg ellipse bottom
           figures
            text 'MSe' 656 88 color 0 18 bold;
          end;
          implementation eq
variables
	real flow[4,1];
	real theta4;
	real H4_3[4,4];
	
parameters
	real d4 = 0.10915, a4 = 0, alpha4 = 1.57079, q4_0 = 0.0;
   real m4 = 1.1219, g=9.81;
	real fg4[4,1] = [0;0;-m4*g;0];
	
equations
	theta4 = q4 + q4_0;
	
	H4_3 = [cos(theta4),-sin(theta4)*cos(alpha4),sin(theta4)*sin(alpha4),a4*cos(theta4); 
	     sin(theta4),cos(theta4)*cos(alpha4),-cos(theta4)*sin(alpha4),	a4*sin(theta4); 
	     0,         sin(alpha4),            cos(alpha4),            		d4;
	     0,         0,                     0,                    1];
	
	H4_0 = H4_3 * H3_0;
	
	FG.e = transpose(H4_0) * fg4;
	flow = FG.f;
implementation_end;
         MTFA 313 152
          description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\3D\MTF-3.emx</LibraryPath><TimeStamp>2007-9-25 12:11:21</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
          type 'MTF-3'
           ports
