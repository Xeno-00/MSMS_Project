         MTF 544 184
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MTF.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:15:31</TimeStamp>
</Description>
</Information>';
          type MTF
           ports
            power in p1 [3,1];
            power out p2 [3,1];
            signal in q;
           restrictions
            causality constraint not_equal p1 p2;
          end;
          icon bg ellipse bottom
           figures
            text 'MTF' 544 184 color 0 18 bold;
          end;
          implementation eq

variables
	real R_AB [3,3];
equations
  R_AB = [cos(q),-sin(q),0;
          sin(q),cos(q),0;
          0,0,1];
	p2.e = transpose(R_AB) * p1.e ;
	p1.f = R_AB * p2.f;
implementation_end;
         MTF1 544 344
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
