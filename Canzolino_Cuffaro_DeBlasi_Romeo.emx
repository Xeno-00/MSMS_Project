implementation_end;
        end;
        connections
         ActuatorT => FlowSensor1\p1;
         FlowSensor1\flow -> Integrate\input;
         FlowSensor1\p2 => ZeroJunction\p;
         input => PowerDemux2\input;
         Integrate\q -> Splitter1\input;
         LC\output => MTF\p1;
         MTF\p2 => PowerMux1\input1 688 184;
         MTF1\p2 => PowerMux1\input2 688 344;
         PowerDemux\output1 => RC\input;
         PowerDemux\output2 => ZeroJunction\p;
         PowerDemux2\output1 => LC\input 232 184;
         PowerDemux2\output2 => PowerDemux\input 232 416;
         PowerMux\output => MTF1\p1 544 416;
         PowerMux1\output => output;
         RC\output => PowerMux\input1;
         Splitter1\output -> MTF\q 544 296;
         Splitter1\output -> MTF1\q 544 296;
         Splitter1\output -> q3;
         ZeroJunction\p => PowerMux\input2;
        end;
       implementation_end;
      L3 788 236
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Graphical'
        ports
         power in A [6,1];
         power out B3 [6,1];
         signal in q3;
         signal in H2_0 [4,4];
         signal out H3_0 [4,4];
       end;
       icon bg shadow 8421504
        figures
         rectangle 736 192 840 280 color 0 fill 9342520;
         text 'name' 788 236 color 0 16;
       end;
       implementation bg
        submodels
         Euler_EQ1 659 202
          description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
          type 'Submodel-Equation'
           ports
            signal out P_OG [3,1]; "position of center of gravity"
            signal out R_OG [3,3]; "orientation"
            power in twist [6,1];
            power in FG [4,1];
           parameters
            real m = 2.33 {kg}; "mass"
            real J[3,3] = [0.0025, 0.0, 0.0034; 0.0, 0.0551, 0.0; 0.0034, 0.0, 0.0546]; "inertia tensor"
            real R_OG_0[3,3] = [1, 0, 0; 0, 0, -1; 0, 1, 0]; "initial value of the rotational matrix"
            real P_OG_0[3,1] = [-0.66754; -0.026501; 0.089156];
          end;
          implementation eq

variables
	real omega[3,1], v[3,1];
	//dynamic equations
	real p[3,1],h[3,1];
	
equations
  v = twist.f[1:3,1];
  omega = twist.f[4:6,1];

	// Euler equations
	p = int(twist.e[1:3,1]+FG.e[1:3,1]-skew(omega)*p);
	h = int(twist.e[4:6,1]-skew(omega)*h);
	
	R_OG = int(R_OG*skew(omega),R_OG_0);
	P_OG = int(R_OG*v,P_OG_0);
	twist.f[1:3,1] = p/m;
	twist.f[4:6] = inverse(J)*h;
	FG.f[1:3,1]  = twist.f[1:3,1];
  	FG.f[4,1]   = 1;

 implementation_end;
         MSe1 656 88
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MSe.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:12:33</TimeStamp>
</Description>
</Information>';
          type MSe
           ports
            power out FG [4,1];
            signal in q3;
            signal in H2_0 [4,4];
            signal out H3_0 [4,4];
           restrictions
            causality fixed out FG;
          end;
          icon bg ellipse bottom
           figures
            text 'MSe' 656 88 color 0 18 bold;
          end;
          implementation eq
variables
	real flow[4,1];
	real theta3;
	real H3_2[4,4];
	
parameters
	real d3 = 0.0, a3 = -0.39225, alpha3 = 0,	q3_0 = 0.0;
   real m3 = 2.33;
	real g = 9.81;	
	real fg3[4,1] = [0;0;-m3*g;0];
	
equations
	theta3 = q3 + q3_0;
	
	H3_2 = [cos(theta3),-sin(theta3)*cos(alpha3),sin(theta3)*sin(alpha3),a3*cos(theta3); 
	     sin(theta3),cos(theta3)*cos(alpha3),-cos(theta3)*sin(alpha3),	a3*sin(theta3); 
	     0,         sin(alpha3),            cos(alpha3),            		d3;
	     0,         0,                     0,                    1];
	
	H3_0 = H3_2 * H2_0;
	
	FG.e = transpose(H3_0) * fg3;
	flow = FG.f;
implementation_end;
         MTFA 313 152
          description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\3D\MTF-3.emx</LibraryPath><TimeStamp>2007-9-25 12:11:21</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
          type 'MTF-3'
           ports
            power in p1LA [6,1];
            power out p2LA [6,1];
            signal in r [6,6];
           restrictions
            causality constraint not_equal p1LA p2LA;
          end;
          icon bg ellipse bottom
           figures
            text 'MTF' 313 152 color 0 18 bold;
          end;
          implementation eq
equations					
	p2LA.e =  transpose(r) *p1LA.e;
	p1LA.f =  (r) *p2LA.f ;
implementation_end;
         MTFB 321 256
          description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\3D\MTF-3.emx</LibraryPath><TimeStamp>2007-9-25 12:11:21</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
          type 'MTF-3'
           ports
            power in p1LB [6,1];
            power out p2LB [6,1];
            signal in r [6,6];
           restrictions
            causality constraint not_equal p1LB p2LB;
          end;
          icon bg ellipse bottom
           figures
            text 'MTF' 321 256 color 0 18 bold;
          end;
          implementation eq
equations					
	p1LB.e =  transpose(r) * p2LB.e;
	p2LB.f =  (r) * p1LB.f;
	
	implementation_end;
         plug B3 184 256;
         plug q3 656 32;
         plug H2_0 576 88;
         plug H3_0 744 88;
         plug A 184 152;
         OneJunction 440 200
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\OneJunction.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:17:51</TimeStamp>
</Description>
