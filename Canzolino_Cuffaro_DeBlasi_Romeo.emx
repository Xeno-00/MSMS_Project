      L5 792 260
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Graphical'
        ports
         power in A [6,1];
         power out B5 [6,1];
         signal in q5;
         signal in H4_0 [4,4];
         signal out H5_0 [4,4];
       end;
       icon bg shadow 8421504
        figures
         rectangle 728 208 856 312 color 0 fill 55295;
         text 'name' 792 260 color 0 16;
       end;
       implementation bg
        submodels
         Euler 667 202
          description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
          type 'Submodel-Equation'
           ports
            signal out P_OG [3,1]; "position of center of gravity"
            signal out R_OG [3,3]; "orientation"
            power in twist [6,1];
            power in FG [4,1];
           parameters
            real m = 1.1249 {kg}; "mass"
            real J[3,3] = [0.0012, 0.0, 0.0; 0.0, 0.0012, 0.0; 0.0, 0.0, 9.0e-4]; "inertia tensor"
            real R_OG_0[3,3] = [1, 0, 0; 0, 0, -1; 0, 1, 0]; "initial value of the rotational matrix"
            real P_OG_0[3,1] = [-0.817248; -0.12549; -0.00369];
          end;
          implementation eq

variables
	real omega[3,1], v[3,1];
	// dynamic equations
	real p[3,1],h[3,1];
	
equations
	v = twist.f[1:3,1];
	omega = twist.f[4:6,1];

	//Euler equations
	p = int(twist.e[1:3,1]+FG.e[1:3,1]-skew(omega)*p);
	h = int(twist.e[4:6,1]-skew(omega)*h);
	
	R_OG = int(R_OG*skew(omega),R_OG_0);
	P_OG = int(R_OG*v,P_OG_0);
	twist.f[1:3,1] = p/m;
	twist.f[4:6] = inverse(J)*h;
	FG.f[1:3,1]  = twist.f[1:3,1];
  	FG.f[4,1]   = 1;



 implementation_end;
         MSe1 664 88
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MSe.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:12:33</TimeStamp>
</Description>
</Information>';
          type MSe
           ports
            power out FG [4,1];
            signal in q5;
            signal in H4_0 [4,4];
            signal out H5_0 [4,4];
           restrictions
            causality fixed out FG;
          end;
          icon bg ellipse bottom
           figures
            text 'MSe' 664 88 color 0 18 bold;
          end;
          implementation eq
variables
	real flow[4,1];
	real theta5;
	real H5_4[4,4];
	
parameters
	real d5 = 0.09465,a5 = 0, alpha5 = -1.57079, q5_0 = 0.0;
   real m5 = 1.1219, g=9.81;
	real fg5[4,1] = [0;0;-m5*g;0];
	
equations
	theta5  = q5 + q5_0;
	
	H5_4 = [cos(theta5), -sin(theta5)*cos(alpha5), sin(theta5)*sin(alpha5) , a5*cos(theta5); 
	     	  sin(theta5), cos(theta5)*cos(alpha5) , -cos(theta5)*sin(alpha5), a5*sin(theta5); 
	        0          , sin(alpha5)             , cos(alpha5)             , d5            ; 
	        0          , 0                       , 0                       , 1            ];
	
	H5_0 = H5_4 * H4_0;
	
	FG.e = transpose(H5_0) * fg5;
	flow = FG.f;
implementation_end;
         MTFA 313 152
          description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\3D\MTF-3.emx</LibraryPath><TimeStamp>2007-9-25 12:11:21</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
          type 'MTF-3'
           ports
            power in p1LA [6,1];
            power out p2LA [6,1];
            signal in r [6,6];
           restrictions
            causality constraint not_equal p1LA p2LA;
          end;
          icon bg ellipse bottom
           figures
            text 'MTF' 313 152 color 0 18 bold;
          end;
          implementation eq
equations					
	p2LA.e =  inverse(r) *p1LA.e;
	p1LA.f =  (r) *p2LA.f ;
implementation_end;
         MTFB 321 256
          description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\3D\MTF-3.emx</LibraryPath><TimeStamp>2007-9-25 12:11:21</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
          type 'MTF-3'
           ports
            power in p1LB [6,1];
            power out p2LB [6,1];
            signal in r [6,6];
           restrictions
            causality constraint not_equal p1LB p2LB;
          end;
          icon bg ellipse bottom
           figures
            text 'MTF' 321 256 color 0 18 bold;
          end;
          implementation eq
equations					
	p1LB.e =  transpose(r) * p2LB.e;
	p2LB.f =  (r) * p1LB.f;
	
	implementation_end;
         plug B5 184 256;
         plug q5 664 32;
         plug H4_0 584 88;
         plug H5_0 760 88;
         plug A 184 152;
         OneJunction 440 200
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\OneJunction.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:17:51</TimeStamp>
</Description>
</Information>';
          knot OneJunction
           ports
            power knot duplicatable none p [6,1];
            signal knot out flow [6,1];
           restrictions
            causality constraint one_out p;
          end;
          icon bg ellipse
           figures
            text '1' 440 200 color 0 18 bold;
          end;
