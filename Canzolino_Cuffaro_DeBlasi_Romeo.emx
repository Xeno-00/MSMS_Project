          icon bg ellipse bottom
           figures
            text 'R' 212 136 color 0 18 bold;
          end;
          implementation eq
variables
	real flow;


parameters
	real B       = 6.1e-4; //viscous coefficient (B = 6.4e-4 without payload)
	real B_plus  = 0.008;  //coulumb friction
	real B_minus = -0.007; //coulumb friction
	
equations
	flow = p.f;
	if flow > 0 then
		p.e = B*p.f + B_plus;
	else
		p.e = B*p.f + B_minus;
	end;
implementation_end;
         R1 600 480
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\R.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:35:37</TimeStamp>
</Description>
</Information>';
          type R
           ports
            power in p;
          end;
          icon bg ellipse bottom
           figures
            text 'R' 600 480 color 0 18 bold;
          end;
          implementation eq
parameters
	real r = 0.1;
equations
	p.e = r * p.f;
implementation_end;
         Spring 400 480
          description '<Information><Description><Version>4.2</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\C.emx</LibraryPath><TimeStamp>2011-11-29 15:58:35</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
          type C
           ports
            power in p;
            signal out state;
           restrictions
            causality preferred out p;
          end;
          icon bg ellipse bottom
           figures
            text 'C' 400 480 color 0 18 bold;
          end;
          implementation eq
variables
	//real c;
   real phi1;
   real phi2;

parameters
	real k1 = 4.7e3;
	real k2 = 6.1e3;
	real k3 = 7.2e3;
	real T1 = 2;
	real T2 = 6.9;

equations
	state = int(p.f); // state is phi
	
   phi1 = T1/k1;
   phi2 = T1/k1+ (T2-T1)/k2; 

	if state <= phi1 and state >= -phi1 then   // first region
		p.e = state * k1;
	 
	elsif state > phi2 or state < -phi2 then // third region
		p.e = (state -sign(state)*phi2)*k3 +sign(state)*T2;
	else                                       // second region
		p.e = (state -sign(state)*phi1)*k2 +sign(state)*T1;
	end;implementation_end;
         TF 256 376
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\TF.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:43:47</TimeStamp>
</Description>
</Information>';
          type TF
           ports
            power in p1;
            power out p2;
           restrictions
            causality constraint not_equal p1 p2;
          end;
          icon bg ellipse bottom
           figures
            text 'TF' 256 376 color 0 18 bold;
          end;
          implementation eq
parameters
	real r = -100;
equations
	p2.e = r * p1.e;
	p1.f = r * p2.f;
implementation_end;
         ZeroJunction2 436 376
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
