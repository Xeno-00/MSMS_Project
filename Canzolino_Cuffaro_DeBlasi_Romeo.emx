    implementation bg
     submodels
      C1 272 312
       description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Signal\Control\PID Control\Continuous\PID.emx</LibraryPath><TimeStamp>2008-1-17 10:49:30</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate><Configuration><struct><member><name>DocumentationMask</name><value><struct><member><name>MaskChoice</name><value><int>0</int></value></member></struct></value></member></struct></Configuration></Description></Information>';
       type PID
        ports
         signal in SP;
         signal in MV;
         signal out output;
       end;
       icon bg bottom
        figures
         rectangle 256 296 288 328 color 0 fill 15132390;
         text 'PID
' 272 311.5 color 16711680 14 bold;
       end;
       implementation eq
parameters
	real kp = -2.0 {};		// Proportional gain 
	
	real tauI = 0.5 {s};		// Integral time constant: tauI > 0 (speed at which the integral action accumulates in response to the error)
	real tauA = 0.1 {s};		// Anti-windup/tracking time constant: tauA > 0 (prevents the integrator from accumulating excessive error)

	real tauD = 0.1 {s};		// Derivative time constant: tauD > 0
	real N = 20 {};			// Derivative gain limitation (limits the amplification of noise that the derivative can generate)
	
	real min_val = -7 {};	// Minimum output
	real max_val = 7 {};		// Maximum output
	
variables
	real error;
	real hidden uP;
	real hidden uI;
	real hidden uD, uDstate;
	real hidden desired_output;
	
equations
	error = SP - MV;
	
	uP = kp * error ;
	
	uI = int ( kp * error / tauI  -  ( desired_output - output ) / tauA );
	
	uDstate = int ( uD * N / tauD );
	uD = kp * error * N - uDstate;	   
	
	desired_output = uP + uI + uD;
		
	output = limit(desired_output, min_val, max_val);



      
implementation_end;
      D1 484 312
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
