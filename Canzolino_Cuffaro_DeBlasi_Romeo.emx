          knot ZeroJunction
           ports
            power knot duplicatable none p [1];
            signal knot out effort [1];
           restrictions
            causality constraint one_in p;
          end;
          icon bg ellipse
           figures
            text '0' 436 376 color 0 18 bold;
          end;
          implementation eq
equations
	sum (direct (p.f)) = 0;
	equal (collect (p.e));
	effort = first (p.e);
implementation_end;
        end;
        connections
         I\p <= OneJunction2\p;
         input => OneJunction2\p;
         OneJunction\p => R1\p;
         OneJunction2\p => TF\p1;
         output <= OneJunction\p;
         R\p <= OneJunction2\p;
         TF\p2 => ZeroJunction2\p;
         ZeroJunction2\p => OneJunction\p;
         ZeroJunction2\p => Spring\p;
        end;
       implementation_end;
