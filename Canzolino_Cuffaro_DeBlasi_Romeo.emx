          end;
          icon bg ellipse bottom
           figures
            text 'TF' 384 264 color 0 18 bold;
          end;
          implementation eq
parameters
	real r = -100;
equations
	p2.e = r * p1.e;
	p1.f = r * p2.f;
implementation_end;
