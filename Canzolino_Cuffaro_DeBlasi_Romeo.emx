         RC 424 400
          description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
          type 'Submodel-Graphical'
           ports
            power in input [2,1];
            power out output [2,1];
          end;
          implementation bg
           submodels
            ConstraintForce1 416 160
             type 'ConstraintForce-Relative'
              ports
               power out p [2,1];
              restrictions
               causality fixed out p;
             end;
             icon ipm ellipse top
              figures
               line 432 160 448 160 color 0 end;
               text 'v = 0' 416 160 color 0 14;
               line 400 160 384 160 color 0 end;
             end;
             implementation eq
equations
	// Note: the constraint function is used here
	p.e = constraint(p.f);
	// you can read the equation as:
	// On every simulation step make p.F such that p.v remains zeroimplementation_end;
            plug input 192 256;
            plug output 720 256;
            ZeroJunction4 416 256
             description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\ZeroJunction.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:45:16</TimeStamp>
</Description>
</Information>';
             knot ZeroJunction
              ports
               power knot duplicatable none p [2,1];
               signal knot out effort [2,1];
              restrictions
               causality constraint one_in p;
             end;
             icon bg ellipse
              figures
               text '0' 416 256 color 0 18 bold;
             end;
             implementation eq
equations
	sum (direct (p.f)) = 0;
	equal (collect (p.e));
	effort = first (p.e);
implementation_end;
           end;
           connections
            ConstraintForce1\p => ZeroJunction4\p;
            ZeroJunction4\p <= input;
            ZeroJunction4\p => output;
           end;
          implementation_end;
         Splitter1 632 296
          description '<Description><Version>4.0</Version>
   <LibraryPath>Signal\Block Diagram\Splitter.emx</LibraryPath>
  <TimeStamp>2008-01-17 11:28:29</TimeStamp>
<IsMainModel>1</IsMainModel>
 <KeepParameterValues>False</KeepParameterValues>
</Description>';
          knot Splitter
           ports
            signal knot duplicatable out output [1];
            signal knot in input [1];
          end;
          icon bg ellipse bottom
           figures
            ellipse 628.8 292.8 635.2 299.2 color -1 fill 0;
            ellipse 627.7 291.7 636.3 300.3 color -1;
           terminals
            input 632 296 fixed;
          end;
          implementation eq
equations
    collect (output) = input;
implementation_end;
         ZeroJunction 360 424
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\ZeroJunction.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:45:16</TimeStamp>
</Description>
</Information>';
          knot ZeroJunction
           ports
            power knot duplicatable none p [1];
            signal knot out effort [1];
           restrictions
            causality constraint one_in p;
          end;
          icon bg ellipse
           figures
            text '0' 360 424 color 0 18 bold;
          end;
          implementation eq
equations
	sum (direct (p.f)) = 0;
	equal (collect (p.e));
	effort = first (p.e);
	
implementation_end;
        end;
        connections
         ActuatorT => FlowSensor1\p1;
         FlowSensor1\flow -> Integrate\input;
         FlowSensor1\p2 => ZeroJunction\p;
         input => PowerDemux2\input;
         Integrate\q -> Splitter1\input;
         LC\output => MTF\p1;
         MTF\p2 => PowerMux1\input1 688 184;
         MTF1\p2 => PowerMux1\input2 688 344;
         PowerDemux\output1 => RC\input;
         PowerDemux\output2 => ZeroJunction\p;
         PowerDemux2\output1 => LC\input 232 184;
         PowerDemux2\output2 => PowerDemux\input 232 416;
         PowerMux\output => MTF1\p1 544 416;
         PowerMux1\output => output;
         RC\output => PowerMux\input1;
         Splitter1\output -> MTF\q 544 296;
         Splitter1\output -> MTF1\q 544 296;
         Splitter1\output -> q6;
         ZeroJunction\p => PowerMux\input2;
