          end;
          implementation eq

variables
	real R_AB [3,3];
equations
  R_AB = [cos(q),-sin(q),0;
          sin(q),cos(q),0;
          0,0,1];
	p2.e = transpose(R_AB) * p1.e ;
	p1.f = R_AB * p2.f;
implementation_end;
